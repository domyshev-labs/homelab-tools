// Only the disk-window script, not the whole Proxmox journal.
loki.relabel "zfs_disk_standby_scheduler" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
}

loki.source.journal "zfs_disk_standby_scheduler" {
  matches = "SYSLOG_IDENTIFIER=zfs-disk-standby-scheduler"
  max_age = "24h"
  labels = {
    host = "proxmox",
    service = "zfs-disk-standby-scheduler",
  }
  relabel_rules = loki.relabel.zfs_disk_standby_scheduler.rules
  forward_to = [loki.process.zfs_disk_standby_scheduler.receiver]
}

loki.process "zfs_disk_standby_scheduler" {
  stage.json {
    expressions = {
      level = "level",
    }
  }
  stage.labels {
    values = {
      level = "",
    }
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "http://LOKI_HOST:3100/loki/api/v1/push"
  }
  wal {
    enabled = true
  }
}
