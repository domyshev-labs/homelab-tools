[Unit]
Description=Send only zfs-disk-standby-scheduler logs to the configured Loki server
After=network-online.target
Wants=network-online.target

[Service]
User=alloy
Group=alloy
SupplementaryGroups=adm systemd-journal
Type=simple
ExecStart=/usr/bin/alloy run --storage.path=/var/lib/alloy-zfs-disk-standby-scheduler --server.http.listen-addr=127.0.0.1:12346 /etc/alloy-zfs-disk-standby-scheduler/config.alloy
Restart=on-failure
RestartSec=5
StateDirectory=alloy-zfs-disk-standby-scheduler
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
