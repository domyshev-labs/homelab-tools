[Unit]
Description=Denied Caddy connection metadata observer
After=network.target

[Service]
ExecStart=/usr/bin/python3 -B /opt/caddy-access/observe.py
Restart=on-failure
RestartSec=3
UMask=0022
RuntimeDirectory=caddy-access
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_NETLINK AF_PACKET AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/run/caddy-access

[Install]
WantedBy=multi-user.target
