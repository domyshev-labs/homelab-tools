[Unit]
Description=Private Caddy access-list API
After=network.target

[Service]
User=caddy-access
Group=caddy-access
EnvironmentFile=/etc/caddy-access/api.env
ExecStart=/usr/bin/python3 -B /opt/caddy-access/access.py api
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/caddy-access
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
